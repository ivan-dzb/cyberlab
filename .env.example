# Copia a .env y ajusta. NUNCA commitear .env.
POSTGRES_USER=cyberlab
POSTGRES_PASSWORD=cambia-esto-en-local
POSTGRES_DB=cyberlab

# Para `npm run dev` fuera de Docker (Postgres expuesto solo en 127.0.0.1:5432)
DATABASE_URL=postgres://cyberlab:cambia-esto-en-local@localhost:5432/cyberlab

# Tokens internos entre servicios (genera con: openssl rand -hex 32). Nunca los compartas ni commitees .env.
ORCH_TOKEN=genera-un-valor-aleatorio-de-64-hex
GATEWAY_TOKEN=genera-otro-valor-aleatorio-de-64-hex
# URL pública de los retos; {sid} se reemplaza por el id de sesión (un origen distinto al de la web).
LAB_BASE_URL=http://{sid}.lab.localhost:8081
